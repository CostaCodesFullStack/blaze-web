DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Redirect URI do fluxo de instalacao do bot (register in the Discord Developer
# Portal under the same application's OAuth2 redirects).
DISCORD_SUBSCRIBE_REDIRECT_URI=http://localhost:3000/api/subscribe/discord/callback
# Segredo usado para assinar o state do fluxo de instalacao. Gere um valor
# longo e aleatorio, ex:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_STATE_SECRET=
# Stripe (server-side only). Valores reais ficam apenas no .env local / painel.
# STRIPE_SECRET_KEY deve ser a secret key do Stripe, nunca exposta ao client.
STRIPE_SECRET_KEY=
# Stripe Price IDs da aplicacao (Price IDs "one-time"-recurring do plano).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_YEARLY=
# Stripe webhook secret (server-side only). Gerado no painel do Stripe em
# Developers > Webhooks. Nunca exposto ao client.
STRIPE_WEBHOOK_SECRET=
# Blaze Bot backend (server-only). URL base do servidor HTTP do bot. Se vazio,
# o painel reporta a integração como sem configuração (offline).
BLAZE_BOT_API_URL=
# API key usada pelo painel para autenticar chamadas server-side ao Blaze Bot.
# Nunca exposta ao client e nunca logada.
BLAZE_BOT_API_KEY=
DATABASE_URL="file:./dev.db"